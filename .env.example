# ---------- Core ----------
# The apex domain that landing subdomains are carved from.
ROOT_DOMAIN=hiratalabs.com
# Host that serves the admin panel (must NOT collide with a landing slug).
ADMIN_HOST=admin.hiratalabs.com
# Public URL of the admin panel, used in magic-link emails.
NEXT_PUBLIC_ADMIN_URL=https://admin.hiratalabs.com

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Storage bucket that holds unzipped landing files (create it as PRIVATE).
SUPABASE_STORAGE_BUCKET=landings
# Postgres connection string (Supabase > Project Settings > Database > Connection pooling, mode=session)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------- Resend ----------
RESEND_API_KEY=re_xxxxxxxx
# Verified sending identity for contact-form notifications.
RESEND_FROM="Hirata Labs <noreply@hiratalabs.com>"
# Optional BCC on every form notification (leave empty to disable).
RESEND_BCC=

# ---------- Render (custom domains) ----------
# Render reserves the RENDER_ prefix for its own variables, so the API key uses
# a name of ours. Create it at Render > Account Settings > API Keys.
DEPLOY_API_KEY=rnd_xxxxxxxx
# RENDER_SERVICE_ID and RENDER_EXTERNAL_HOSTNAME are set by Render automatically
# in production. Only set these two for local development:
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxx
# RENDER_SERVICE_HOST=landings.onrender.com

# ---------- Limits ----------
MAX_ZIP_BYTES=104857600
MAX_FILES_PER_SITE=3000

# ---------- Bootstrap ----------
# First admin. If the admins table is empty this email is allowed in and inserted.
BOOTSTRAP_ADMIN_EMAIL=zeymer@moca.app
